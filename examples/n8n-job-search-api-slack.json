{
  "name": "Daily job digest in plain language (Apify Job Search API -> Slack)",
  "nodes": [
    {
      "id": "7a2d3b20-0001-4b7f-8d2e-2b3c4d5e6f01",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 8 }] }
      }
    },
    {
      "id": "7a2d3b20-0002-4b7f-8d2e-2b3c4d5e6f02",
      "name": "Search jobs (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "notes": "Credential: Header Auth with Name = Authorization and Value = Bearer <your Apify API token> (Apify Console > Settings > API & Integrations). Write the query in plain language; postedWithinDays = 1 keeps the jobs posted in the last day.",
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/richiedc95~job-search-api/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"query\": \"senior python developer, data engineer\",\n  \"remoteOnly\": true,\n  \"postedWithinDays\": 1,\n  \"maxResults\": 20,\n  \"maxPerCompany\": 2\n}",
        "options": { "timeout": 300000 }
      }
    },
    {
      "id": "7a2d3b20-0003-4b7f-8d2e-2b3c4d5e6f03",
      "name": "Is it a job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 0],
      "parameters": {
        "conditions": { "string": [{ "value1": "={{ $json.title }}", "operation": "isNotEmpty" }] }
      }
    },
    {
      "id": "7a2d3b20-0004-4b7f-8d2e-2b3c4d5e6f04",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [720, -80],
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#job-alerts", "mode": "name" },
        "text": "=*{{ $json.title }}* at {{ $json.company }}\n{{ $json.location }}{{ $json.salary ? ' · ' + $json.salary : '' }} · posted {{ $json.postedAt }}\n{{ $json.url }}",
        "otherOptions": {}
      }
    }
  ],
  "connections": {
    "Every morning": { "main": [[{ "node": "Search jobs (Apify)", "type": "main", "index": 0 }]] },
    "Search jobs (Apify)": { "main": [[{ "node": "Is it a job?", "type": "main", "index": 0 }]] },
    "Is it a job?": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" }
}
